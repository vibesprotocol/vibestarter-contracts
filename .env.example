# ===========================================
# Vibes Protocol V2 - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Block explorer API key (for contract verification)
BASESCAN_API_KEY=your_basescan_api_key_here

# ===========================================
# Testnet Configuration
# ===========================================

# Set to "true" to deploy mock Aerodrome router (for testnet)
# Set to "false" to use real Aerodrome (mainnet only)
USE_MOCK_AERODROME=true

# Set to "true" to deploy MockTimeOracle (for testnet time manipulation)
# Set to "false" to use block.timestamp (production)
USE_TIME_ORACLE=true

# ===========================================
# Mainnet Configuration (optional)
# ===========================================

# Platform wallet to receive fees (defaults to deployer if not set)
# PLATFORM_WALLET=0x...

# ===========================================
# After Deployment - Add to Frontend .env
# ===========================================
# The deployment script outputs these values:
#
# NEXT_PUBLIC_TOKEN_FACTORY=0x...
# NEXT_PUBLIC_REGISTRY=0x...
# NEXT_PUBLIC_ROUTER_V2=0x...
# NEXT_PUBLIC_ESCROW_FACTORY=0x...
# NEXT_PUBLIC_LP_LOCKER=0x...
# NEXT_PUBLIC_TIME_ORACLE=0x...  (testnet only)
